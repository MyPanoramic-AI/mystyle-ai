{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:tryon": "tsc -p server/tryon-lab/tsconfig.json --noEmit",
    "test:tryon": "tsx --test server/tryon-lab/tests/validation.test.ts server/tryon-lab/tests/jobs.test.ts server/tryon-lab/tests/http.test.ts",
    "tryon-lab": "tsx server/tryon-lab/src/index.ts",
    "lint:shopping": "tsc -p server/shopping/tsconfig.json --noEmit",
    "test:shopping": "tsx --test server/shopping/tests/size.test.ts server/shopping/tests/normalize.test.ts server/shopping/tests/search.test.ts server/shopping/tests/import.test.ts server/shopping/tests/match.test.ts server/shopping/tests/http.test.ts",
    "shopping-lab": "tsx server/shopping/src/index.ts",
    "lint:api": "tsc -p server/api/tsconfig.json --noEmit",
    "test:api": "tsx --test server/api/tests/migrate.test.ts server/api/tests/auth.test.ts server/api/tests/profile.test.ts server/api/tests/isolation.test.ts server/api/tests/media.test.ts server/api/tests/wardrobe.test.ts server/api/tests/family.test.ts server/api/tests/beauty.test.ts server/api/tests/membership.test.ts server/api/tests/privacy.test.ts server/api/tests/infrastructure.test.ts server/api/tests/email-security.test.ts server/api/tests/profile-photos.test.ts server/api/tests/tryon.test.ts",
    "test:email": "tsx --test server/api/tests/email-security.test.ts",
    "test:infra": "tsx --test server/api/tests/infrastructure.test.ts",
    "backup:create": "tsx server/api/src/ops/backupCli.ts create",
    "backup:verify": "tsx server/api/src/ops/backupCli.ts verify",
    "backup:restore": "tsx server/api/src/ops/backupCli.ts restore",
    "test:privacy": "tsx --test server/api/tests/privacy.test.ts",
    "test:membership": "tsx --test server/api/tests/membership.test.ts",
    "test:beauty": "tsx --test server/api/tests/beauty.test.ts",
    "test:family": "tsx --test server/api/tests/family.test.ts",
    "test:wardrobe": "tsx --test server/api/tests/wardrobe.test.ts",
    "test:ai": "tsx --test server/api/tests/ai.test.ts",
    "test:account": "tsx --test server/api/tests/account-client.test.ts",
    "test:e2e": "playwright test",
    "api": "tsx server/api/src/index.ts",
    "start": "tsx server/api/src/index.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
