# Environment template only. Do not commit a real .env or .env.local file.
#
# Current application status (verified 16 October 2026):
# The React frontend does not import @google/genai, dotenv, or Express.
# No server.js file exists. These variables are not read by the running UI.
# Do not place a live API key in frontend code or in a Vite-exposed variable.

# GEMINI_API_KEY: Reserved for a future server-side AI integration.
# The exported AI Studio README asks for this value in .env.local.
# It is unused by the current frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Reserved for a future hosted deployment.
# Unused by the current frontend.
APP_URL="MY_APP_URL"

# Virtual try-on lab (server/tryon-lab) and customer API try-on orchestration (server/api).
# Put real values in server/tryon-lab/.env or server/api/.env (gitignored). Never commit a live key.
# TRYON_LAB_TOKEN is a local developer password for the lab API. It is not a provider key.
# Customer Simulate Fit uses the account API mock provider by default.
# TRYON_ALLOW_LIVE must stay unset or false until a paid call is explicitly approved.
# Staging/production also require TRYON_LIVE_APPROVAL_ACK=i-approve-paid-fashn-tryon.
# TRYON_MAX_BUDGET_USD defaults to 0, which blocks every positive-cost call.
# TRYON_MAX_AUTO_RETRIES is clamped to 0 or 1.
# TRYON_ALLOW_CUSTOMER_MOCK defaults on only for development/test; keep unset/false for staging/production.
# TRYON_CUSTOMER_CREDIT_COST is internal membership credits for one live try-on (not FASHN API credits).
# FASHN_API_KEY is read only by server processes. Never expose it to Vite.
TRYON_LAB_TOKEN=
FASHN_API_KEY=
TRYON_ALLOW_LIVE=false
TRYON_LIVE_APPROVAL_ACK=
TRYON_MAX_BUDGET_USD=0
TRYON_MAX_AUTO_RETRIES=0
TRYON_PROVIDER_TIMEOUT_MS=90000
TRYON_ALLOW_CUSTOMER_MOCK=
TRYON_CUSTOMER_CREDIT_COST=1


# Shopping lab (server/shopping). Put the real token in server/shopping/.env.
# SHOPPING_LAB_HOST must stay 127.0.0.1 or localhost.
SHOPPING_LAB_TOKEN=
SHOPPING_LAB_HOST=127.0.0.1
SHOPPING_LAB_PORT=4321
SHOPPING_FRESH_HOURS=24

# Application API (server/api). Leave the admin token empty to disable /api/admin/audit.
# Put a real admin token only in server/api/.env. Never commit credentials.
# APP_ENV: development | test | staging | production
# Local: API_HOST must stay 127.0.0.1 or localhost; Secure cookies stay off on HTTP.
# Staging/production: require https public origin, Secure cookies, admin token, non-localhost origins.
# On Render, mount a persistent disk and set API_DATA_DIR to that absolute mount path.
# Leave API_ALLOWED_ORIGINS empty to allow only the local Vite origins on ports 3000 and 4173.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=4331
API_PUBLIC_ORIGIN=
API_DATA_DIR=
API_SECURE_COOKIE=false
API_TRUST_PROXY=false
API_SERVE_STATIC=false
API_SESSION_HOURS=168
API_MEDIA_MAX_BYTES=8388608
API_AUTH_RATE_LIMIT=20
API_AUTH_RATE_WINDOW_MS=900000
API_MEDIA_RETENTION_DAYS=30
API_RETENTION_CLEANUP_ENABLED=false
API_RETENTION_CLEANUP_ACK=
API_ALLOWED_ORIGINS=
API_ADMIN_TOKEN=
API_LOG_LEVEL=info
PAYMENTS_ENABLED=false

# Transactional email (verification, password reset, family link invites).
# Capture is local-only. Do not enable EMAIL_CAPTURE_ENABLED on staging/production.
# Live SMTP uses the same Office 365 mailbox settings as other My Panoramic apps.
APP_PUBLIC_URL=
EMAIL_CAPTURE_ENABLED=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=No-Reply@mypanoramic.com
SMTP_PASS=
SMTP_FROM=MyStyle AI <No-Reply@mypanoramic.com>
API_VERIFICATION_TOKEN_MINUTES=60
API_RESET_TOKEN_MINUTES=30
API_REQUIRE_EMAIL_VERIFIED=false

# Stylist. Live model calls stay off until AI_ALLOW_LIVE is exactly true, a model is set,
# OPENAI_API_KEY is present, both budgets are above zero, and (for staging/production)
# AI_LIVE_APPROVAL_ACK=i-approve-paid-openai-stylist.
# Prices must be copied from the provider's current pricing page into the two rate variables.
# The example never contains a working key. Put OPENAI_API_KEY only in server/api/.env.
AI_ALLOW_LIVE=false
AI_LIVE_APPROVAL_ACK=
AI_PROVIDER=mock
AI_MODEL=
AI_MAX_BUDGET_USD=0
AI_MAX_USER_BUDGET_USD=0
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_INPUT_CHARS=2000
AI_TIMEOUT_MS=20000
AI_MESSAGE_RATE_LIMIT=30
AI_MESSAGE_RATE_WINDOW_MS=900000
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_CACHED_INPUT_USD_PER_MILLION=
OPENAI_API_KEY=
AI_MAX_INPUT_TOKENS=4000
AI_THINKING_BUDGET=0
AI_MAX_LIVE_REQUESTS=0
