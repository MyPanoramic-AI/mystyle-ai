# Environment template only. Do not commit a real .env or .env.local file.
#
# Current application status (verified 16 October 2026):
# The React frontend does not import @google/genai, dotenv, or Express.
# No server.js file exists. These variables are not read by the running UI.
# Do not place a live API key in frontend code or in a Vite-exposed variable.

# GEMINI_API_KEY: Reserved for a future server-side AI integration.
# The exported AI Studio README asks for this value in .env.local.
# It is unused by the current frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Reserved for a future hosted deployment.
# Unused by the current frontend.
APP_URL="MY_APP_URL"

# Virtual try-on lab (server/tryon-lab). Put real values in server/tryon-lab/.env,
# which is gitignored. Never commit a live key.
# TRYON_LAB_TOKEN is a local developer password for the lab API. It is not a provider key.
# TRYON_ALLOW_LIVE must stay unset or false until a paid call is explicitly approved.
# TRYON_MAX_BUDGET_USD defaults to 0, which blocks every positive-cost call.
# TRYON_MAX_AUTO_RETRIES is clamped to 0 or 1.
TRYON_LAB_TOKEN=
FASHN_API_KEY=
TRYON_ALLOW_LIVE=false
TRYON_MAX_BUDGET_USD=0
TRYON_MAX_AUTO_RETRIES=0

# Shopping lab (server/shopping). Put the real token in server/shopping/.env.
# SHOPPING_LAB_HOST must stay 127.0.0.1 or localhost.
SHOPPING_LAB_TOKEN=
SHOPPING_LAB_HOST=127.0.0.1
SHOPPING_LAB_PORT=4321
SHOPPING_FRESH_HOURS=24

# Production API (server/api). Leave the admin token empty to disable /api/admin/audit.
# Put a real admin token only in server/api/.env. API_HOST must stay 127.0.0.1 or localhost.
# Session cookies are HttpOnly and not Secure on local HTTP. Production needs HTTPS and Secure.
API_HOST=127.0.0.1
API_PORT=4331
API_SESSION_HOURS=168
API_MEDIA_MAX_BYTES=8388608
API_AUTH_RATE_LIMIT=20
API_AUTH_RATE_WINDOW_MS=900000
API_MEDIA_RETENTION_DAYS=30
API_ALLOWED_ORIGINS=
API_ADMIN_TOKEN=
